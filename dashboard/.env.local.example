# Server-side base URL used by the BFF route handlers (never exposed to the
# browser). Falls back to NEXT_PUBLIC_API_URL; required in production.
API_URL=http://localhost:3002/api

NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_WS_URL=ws://localhost:3002

# Google OAuth Web client ID (https://console.cloud.google.com -> Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Sign in with Apple on the web (optional, recommended — iOS users who signed up
# with Apple need it to reach the dashboard). Apple Developer → Identifiers →
# Services IDs; add this site's domain and https://<domain>/auth/login as a
# return URL. Set the same value as APPLE_SERVICES_ID on the backend.
NEXT_PUBLIC_APPLE_SERVICES_ID=

# Product analytics. The dashboard is now reachable on every tier, which makes
# it the primary conversion surface — it had no instrumentation at all.
# Use the SAME PostHog project as the mobile app so identities resolve.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
