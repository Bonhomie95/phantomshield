{
  "name": "phantomshield-backend",
  "version": "1.0.0",
  "description": "PhantomShield API — Personal Security Intelligence Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "migrate:indexes": "node dist/scripts/migrate-indexes.js",
    "migrate:indexes:dev": "ts-node-dev --transpile-only -r tsconfig-paths/register src/scripts/migrate-indexes.ts",
    "test": "jest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1137.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@phantomshield/shared": "*",
    "@sentry/node": "^10.73.0",
    "apple-signin-auth": "^1.7.6",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.8.5",
    "google-auth-library": "^9.15.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.6.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "eslint": "^8.57.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
