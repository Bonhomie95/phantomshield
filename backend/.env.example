# Server
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# Database — MongoDB holds everything durable (accounts, evidence, photos, the
# remote-command queue). With REDIS_URL unset it also holds the short-lived
# state below, so one MongoDB is all a single-instance deployment needs.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/phantomshield

# Optional Redis. When set it takes over short-lived state (token blocklist,
# WebSocket tickets, presence, throttles, caches), shares rate-limit counters
# across instances, and fans WebSocket events out between API instances.
# Required once you run more than one API instance.
REDIS_URL=

# Auth
# JWT_SECRET must be >= 32 chars (the server refuses to boot otherwise). Refresh
# tokens are opaque random values stored hashed in Mongo — there is no separate
# refresh secret. Refresh lifetime is fixed at 7 days server-side.
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this
JWT_EXPIRES_IN=15m

# Google OAuth — REQUIRED for Google sign-in. The client IDs must mirror the
# mobile app's EXPO_PUBLIC_GOOGLE_* values; token verification checks the
# audience against this list and rejects everything if they're missing.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com

# Apple Sign-In audience (defaults to the app bundle id if unset)
APPLE_BUNDLE_ID=dev.bonhomie95.phantomshield
# Services ID for Sign in with Apple on the web dashboard (optional)
APPLE_SERVICES_ID=
# Sign in with Apple key (App Store Connect → Keys). REQUIRED for App Store
# compliance: account deletion must revoke the user's Apple token.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 file; literal "\n" sequences are accepted.
APPLE_PRIVATE_KEY=

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# Transactional email — the fallback alert channel. REQUIRED in practice: an
# intruder push deliberately excludes the device it came from, so a user with a
# single device (the whole free tier) is only reachable by email.
# Sent with Amazon SES. EMAIL_FROM must be on a verified SES identity (domain
# or address) in AWS_REGION. The IAM user only needs ses:SendEmail.
EMAIL_FROM=PhantomShield <alerts@phantomshield.app>
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: an SES configuration set for bounce/complaint events.
SES_CONFIGURATION_SET=

# Error tracking (backend). Without this every 500 is discarded to stdout.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Mongo connection pool. /dashboard/overview fires 8 parallel operations, so the
# old default of 10 let two concurrent loads starve the instance.
MONGO_MAX_POOL=50
MONGO_MIN_POOL=5

# Index migrations run explicitly (npm run migrate:indexes), never at boot in
# production. Set true only if you want automatic sync in a throwaway env.
AUTO_SYNC_INDEXES=false

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=60000

# RevenueCat webhook shared secret (Authorization: Bearer <secret>)
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# Link shared in referral invites (defaults to the Play Store listing)
REFERRAL_SHARE_URL=
