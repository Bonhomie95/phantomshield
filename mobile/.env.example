# PhantomShield mobile — copy to .env for local development.
# For EAS builds, set these as EAS environment variables (expo.dev → project →
# Environment variables) for the "production" environment: .env is git-ignored
# and is NOT uploaded to EAS Build.

# Backend base URL. MUST include the /api prefix.
#   LAN dev:     http://<your-computer-ip>:3002/api
#   Production:  https://api.phantomshield.app/api   (HTTPS required)
EXPO_PUBLIC_API_URL=http://<your-computer-ip>:3002/api

# Google OAuth client IDs (https://console.cloud.google.com -> Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com

# RevenueCat public SDK keys — REQUIRED to sell subscriptions. Without them the
# paywall says subscriptions are unavailable (never a dead "Buy" button).
# Entitlement ids must be `starter` and `pro`; product/package ids must contain
# "starter" or "pro" so the paywall can map them.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Crash reporting (optional)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog product analytics (optional)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public pages (served by the dashboard). Must be live before store submission.
EXPO_PUBLIC_TERMS_URL=https://app.phantomshield.app/terms
EXPO_PUBLIC_PRIVACY_URL=https://app.phantomshield.app/privacy
EXPO_PUBLIC_SUPPORT_URL=https://app.phantomshield.app/support
EXPO_PUBLIC_DASHBOARD_URL=https://app.phantomshield.app
