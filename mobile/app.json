    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.bonhomie95.phantomshield",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "PhantomShield uses the front camera to take a photo when someone enters a wrong PIN or moves your phone while Guard Mode is on. This only happens if you turn Intruder Photos on.",
        "NSFaceIDUsageDescription": "PhantomShield uses Face ID so only you can open the app and stop Guard Mode.",
        "NSLocationWhenInUseUsageDescription": "PhantomShield uses your location only for features you switch on: tagging security events (like a wrong PIN) with where they happened, and finding this phone if it goes missing.",
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PhantomShield records where this phone is in the background — for Find My Phone, or during Guard Mode with background tracking — so you can locate it from the web dashboard if it is lost or stolen. It only runs while you have one of these switched on."
      },
