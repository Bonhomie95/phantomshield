{
  "expo": {
    "name": "PhantomShield",
    "slug": "phantomshield",
    "scheme": "phantomshield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/59774380-33f7-414a-ac86-52528266a0b9",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./src/assets/images/splash-icon.png",
